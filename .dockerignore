# ========================================
# Qaly Project - Docker Ignore
# ========================================

# Build artifacts
**/bin/
**/obj/
**/out/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# Git
.git/
.gitignore

# Docker
**/Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation is excluded except for runtime AI contract schemas referenced by
# Qaly.Infrastructure.csproj during publish.
docs/**
!docs/schemas/
!docs/schemas/ai/
!docs/schemas/ai/progress_summary.schema.json
!docs/schemas/ai/task_skill_suggestion.schema.json
*.md

# OS
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log
logs/

# Tests (không cần trong production image)
tests/
**/TestResults/

# Misc
node_modules/
*.tmp
*.bak
*.swp
