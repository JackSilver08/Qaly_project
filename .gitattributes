# Keep frontend builds byte-for-byte reproducible across Windows and Linux.
src/Qaly.Web/ClientApp/** text eol=lf
vite.config.ts text eol=lf
scripts/*.mjs text eol=lf

# Binary rules must come after the ClientApp text rule so public assets are not
# newline-normalized differently on Windows and Linux.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
