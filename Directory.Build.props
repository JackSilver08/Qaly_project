<!--
  ========================================
  Qaly Project - Directory.Build.props
  Shared build properties for all projects
  ========================================
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <!-- Common package metadata (if published) -->
  <PropertyGroup>
    <Authors>Qaly Team</Authors>
    <Company>Qaly</Company>
    <Product>Qaly Project Management</Product>
    <Copyright>Copyright (c) 2026 Qaly Team</Copyright>
  </PropertyGroup>
</Project>
