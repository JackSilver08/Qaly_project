flowchart TB
  classDef client fill:#fff,stroke:#111827;
  classDef vps fill:#eef2ff,stroke:#3730a3,stroke-width:1.5px;
  classDef ai fill:#ecfeff,stroke:#155e75;
  classDef data fill:#fefce8,stroke:#854d0e;
  classDef external fill:#fff7ed,stroke:#9a3412;

  User[User Browser]:::client
  Nginx[Nginx / HTTPS]:::vps
  API[QALY Backend API + SignalR]:::vps
  SQL[(SQL Server<br/>source of truth)]:::data
  Redis[(Redis<br/>cache + queue)]:::data
  Qdrant[(Qdrant optional<br/>semantic memory P1)]:::data
  AiGateway[AiGateway<br/>provider routing/cache/quota]:::ai
  ApiProvider[AI API Provider<br/>primary for demo quality]:::external
  Ngrok[ngrok tunnel<br/>auth protected]:::external
  Laptop[Local AI Gateway<br/>RTX4060 laptop]:::ai
  Meetily[Meetily Desktop/Worker<br/>transcribe + summary]:::ai
  Ollama[Ollama 7B/8B Q4<br/>fallback/dev]:::ai
  Mock[Mock Provider<br/>golden dataset tests]:::ai

  User --> Nginx --> API
  API --> SQL
  API --> Redis
  API -. optional .-> Qdrant
  API --> AiGateway
  AiGateway --> ApiProvider
  AiGateway --> Mock
  AiGateway -. local fallback .-> Ngrok --> Laptop
  Laptop --> Meetily
  Laptop --> Ollama
  Meetily --> Laptop
  Laptop -->|sync transcript/summary| AiGateway
  AiGateway -->|validated draft only| API
