{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance_checklist.v3.2",
  "type": "object",
  "required": [
    "task_title",
    "checklist"
  ],
  "properties": {
    "task_title": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "type",
          "is_required"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "functional",
              "validation",
              "security",
              "performance",
              "test",
              "documentation"
            ]
          },
          "is_required": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
