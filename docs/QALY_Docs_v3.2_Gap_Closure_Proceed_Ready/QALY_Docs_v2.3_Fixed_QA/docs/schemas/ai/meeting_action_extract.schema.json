{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting_action_extract.v3.2",
  "type": "object",
  "required": [
    "meeting",
    "summary",
    "keywords",
    "action_items",
    "decisions",
    "risks",
    "confidence"
  ],
  "properties": {
    "meeting": {
      "type": "object",
      "required": [
        "title",
        "language"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "assignee",
          "deadline",
          "confidence",
          "source_quote"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ]
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "low",
              "medium",
              "high",
              "urgent",
              null
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_quote": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "reason",
          "confidence"
        ],
        "properties": {
          "decision": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
