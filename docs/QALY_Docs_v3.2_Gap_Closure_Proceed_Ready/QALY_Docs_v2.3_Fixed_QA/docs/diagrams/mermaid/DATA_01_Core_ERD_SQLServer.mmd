  TENANTS {
    uniqueidentifier id PK
    nvarchar code UK
    nvarchar name
    nvarchar status
  }
  USERS {
    uniqueidentifier id PK
    uniqueidentifier tenant_id FK
    nvarchar email UK
    nvarchar password_hash
    nvarchar status
    bit email_verified
  }
  ORGANIZATIONS {
    uniqueidentifier id PK
    uniqueidentifier tenant_id FK
    nvarchar name
    nvarchar status
  }
  PROJECTS {
    uniqueidentifier id PK
    uniqueidentifier tenant_id FK
    uniqueidentifier organization_id FK
    nvarchar code
    nvarchar name
    nvarchar status
    date start_date
    date due_date
  }
  TASKS {
    uniqueidentifier id PK
    uniqueidentifier tenant_id FK
    uniqueidentifier project_id FK
    uniqueidentifier parent_task_id FK
    uniqueidentifier sprint_id FK
    nvarchar title
    nvarchar status
    nvarchar priority
    nvarchar visibility
    datetime2 due_at
  }
  AUDIT_LOGS {
    uniqueidentifier id PK
    uniqueidentifier tenant_id FK
    uniqueidentifier actor_user_id FK
    nvarchar action
    nvarchar entity_type
    uniqueidentifier entity_id
    nvarchar correlation_id
  }
