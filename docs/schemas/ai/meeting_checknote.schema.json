{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting_checknote.v1",
  "type": "object",
  "required": ["summary", "summaryEvidence", "decisions", "risks", "actionItems"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "summaryEvidence": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
    "decisions": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "required": ["text", "reason", "evidence"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 800 },
          "reason": { "type": ["string", "null"], "maxLength": 800 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 800 }
        }, "additionalProperties": false
      }
    },
    "risks": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "required": ["text", "severity", "evidence"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 800 },
          "severity": { "enum": ["low", "medium", "high"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 800 }
        }, "additionalProperties": false
      }
    },
    "actionItems": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "required": ["title", "description", "suggestedOwner", "dueDate", "priority", "evidence"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": ["string", "null"], "maxLength": 2000 },
          "suggestedOwner": { "type": ["string", "null"], "maxLength": 200 },
          "dueDate": { "type": ["string", "null"] },
          "priority": { "enum": ["Low", "Medium", "High", "Critical"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 800 }
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
