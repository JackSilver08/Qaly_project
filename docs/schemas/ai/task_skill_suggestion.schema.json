{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_skill_suggestion.v1",
  "type": "object",
  "required": [
    "schemaId",
    "taskId",
    "sourceVersion",
    "dataState",
    "suggestions",
    "unmappedTerms",
    "generatedAt"
  ],
  "properties": {
    "schemaId": {
      "const": "task_skill_suggestion.v1"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "dataState": {
      "enum": [
        "ready",
        "empty"
      ]
    },
    "suggestions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "skillId",
          "canonicalName",
          "requiredLevel",
          "confidence",
          "rationale",
          "sourceRefs"
        ],
        "properties": {
          "skillId": {
            "type": "string",
            "format": "uuid"
          },
          "canonicalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "requiredLevel": {
            "enum": [
              "Familiar",
              "Proficient",
              "Expert"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unmappedTerms": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
