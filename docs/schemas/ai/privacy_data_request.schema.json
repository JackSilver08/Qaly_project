{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "privacy_data_request.v3.2",
  "type": "object",
  "required": [
    "request_type",
    "requester_user_id",
    "scope",
    "status"
  ],
  "properties": {
    "request_type": {
      "type": "string",
      "enum": [
        "export",
        "delete",
        "anonymize"
      ]
    },
    "requester_user_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "scope": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "processing",
        "completed",
        "rejected"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
