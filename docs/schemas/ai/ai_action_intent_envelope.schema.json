{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_action_intent_envelope.v1",
  "title": "Qaly AI Action Intent Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "projectId", "sourceVersion", "userIntent",
    "intentType", "confidence", "targetEntities", "assumptions", "missingFields",
    "warnings", "options"
  ],
  "properties": {
    "schemaId": { "const": "ai_action_intent_envelope.v1" },
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string", "format": "uuid" },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "userIntent": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "intentType": { "const": "task.create" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "targetEntities": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "label"],
        "properties": {
          "type": { "type": "string", "maxLength": 40 },
          "id": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "assumptions": { "$ref": "#/$defs/textList" },
    "missingFields": { "$ref": "#/$defs/textList" },
    "warnings": { "$ref": "#/$defs/textList" },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/option" }
    },
    "review": { "type": ["object", "null"] },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 500 }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "label", "summary", "tradeOffs", "commands"],
      "properties": {
        "optionId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "tradeOffs": { "$ref": "#/$defs/textList" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/taskCreateCommand" }
        }
      }
    },
    "taskCreateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId", "toolName", "toolVersion", "title", "acceptanceCriteria",
        "priority", "assigneeMode", "requiredSkills", "sourceRefs"
      ],
      "properties": {
        "commandId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "toolName": { "const": "task.create.v1" },
        "toolVersion": { "const": "1.0" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": ["string", "null"], "maxLength": 4000 },
        "acceptanceCriteria": { "$ref": "#/$defs/textList" },
        "priority": { "enum": ["Low", "Medium", "High", "Critical"] },
        "dueDate": { "type": ["string", "null"], "format": "date-time" },
        "estimatedHours": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000 },
        "assigneeId": { "type": ["string", "null"], "format": "uuid" },
        "assigneeMode": { "enum": ["unassigned", "workload_only"] },
        "requiredSkills": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skillId", "requiredLevel"],
            "properties": {
              "skillId": { "type": "string", "format": "uuid" },
              "requiredLevel": { "enum": ["Familiar", "Proficient", "Expert"] }
            }
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
