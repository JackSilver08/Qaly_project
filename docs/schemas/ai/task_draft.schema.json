{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_draft.v3.2",
  "type": "object",
  "required": [
    "title",
    "description",
    "priority",
    "deadline",
    "assignee_suggestion",
    "source_refs",
    "confidence"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ]
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignee_suggestion": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_type",
          "source_id"
        ],
        "properties": {
          "source_type": {
            "type": "string"
          },
          "source_id": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
