{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assignee_recommendation.v3.2",
  "type": "object",
  "required": [
    "task_id",
    "recommendations",
    "method",
    "needs_human_confirm"
  ],
  "properties": {
    "task_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "method": {
      "type": "string"
    },
    "needs_human_confirm": {
      "type": "boolean",
      "const": true
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "member_id",
          "member_name",
          "score",
          "reasons",
          "risks"
        ],
        "properties": {
          "member_id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "member_name": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "skill_match": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "workload_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
