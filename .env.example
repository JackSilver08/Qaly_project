# ========================================
# Qaly Project - Environment Variables
# Copy thành .env để sử dụng
# ========================================

# SQL Server
SQLSERVER_SA_PASSWORD=Qaly@Dev2026!
SQLSERVER_PORT=1434
SQLSERVER_DATABASE=QalyDb

# Redis
REDIS_PORT=6380

# Seq (Logging)
SEQ_ADMIN_PASSWORD=QalySeq@Dev2026!
SEQ_PORT=5341
SEQ_UI_PORT=8081

# MailHog (Fake Email)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# App
APP_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
QALY_SEED_ADMIN_PASSWORD=Qaly@Dev2026!
QALY_SEED_DEFAULT_USER_PASSWORD=Qaly@User2026!
InvitationLink__FrontendBaseUrl=https://dev.qaly.example
InvitationLink__AcceptInvitationPath=/invitations/accept

# LiveKit (leave empty to use meeting fallback without media token)
LiveKit__ServerUrl=
LiveKit__ApiKey=
LiveKit__ApiSecret=
LiveKit__TokenTtlMinutes=120

# GitHub App read-only integration
GitHub__Enabled=false
GitHub__WorkerEnabled=false
GitHub__WebhookSecret=
GitHub__AppId=
GitHub__AppSlug=
# PEM encoded as one line with literal \\n characters; use a secret manager outside local development.
GitHub__PrivateKey=
GitHub__PrivateKeyPath=

# AI services
OLLAMA_PORT=11434
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
Ai__AgentFramework__Enabled=false
Ai__AgentFramework__TimeoutSeconds=45
AI_ASSISTANT_SESSION_ENABLED=false
AI_ASSISTANT_CONTEXT_REGISTRY_ENABLED=false
AI_ASSISTANT_RESEARCH_PLAN_ENABLED=false
AI_ASSISTANT_GOAL_PLANNER_ENABLED=false

# AI GPT Assistant (Dual AI)
CHATGPT2API_PORT=3040
CHATGPT2API_AUTH_KEY=qaly_dev_key
CHATGPT2API_ENABLED=true
