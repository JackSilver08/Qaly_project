{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=QalyDb;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Redis": {  
    "ConnectionString": "localhost:6380"
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": "1025",
    "From": "qaly@local.dev",
    "EnableSsl": "false"
  },
  "InvitationLink": {
    "FrontendBaseUrl": "https://app.qaly.example",
    "AcceptInvitationPath": "/invitations/accept"
  },
  "LiveKit": {
    "ServerUrl": "wss://<livekit-host>",
    "ApiKey": "<livekit-api-key>",
    "ApiSecret": "<livekit-api-secret>",
    "TokenTtlMinutes": 120
  },
  "GitHub": {
    "Enabled": false,
    "WorkerEnabled": false,
    "WebhookSecret": "",
    "AppId": 0,
    "AppSlug": "",
    "PrivateKey": "",
    "PrivateKeyPath": "",
    "ApiBaseUrl": "https://api.github.com",
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 10,
    "MaxAttempts": 5
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Ai": {
    "AgentFramework": {
      "Enabled": true,
      "TimeoutSeconds": 45
    },
    "SemanticEnabled": false,
    "OllamaUrl": "http://localhost:11434",
    "QdrantUrl": "http://localhost:6334",
    "ChatModel": "llama3.2:1b",
    "EmbeddingModel": "nomic-embed-text",
    "VectorSize": 768
  },
  "AiSettings": {
    "Provider": "DeepSeek",
    "FallbackProviders": ["DeepSeek", "Ollama"],
    "AllowProviderDegradedMock": false,
    "AllowLocalSensitiveProcessing": false,
    "ProviderTimeoutSeconds": 30,
    "SchemaRepairAttempts": 2,
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.2:1b"
    },
    "DeepSeek": {
      "BaseUrl": "https://api.deepseek.com",
      "ApiKey": "YOUR_DEEPSEEK_KEY",
      "Model": "deepseek-chat",
      "InputTokenCostPerMillion": 0.435,
      "OutputTokenCostPerMillion": 0.87
    },
    "OpenAI": {
      "ApiKey": "YOUR_OPENAI_KEY",
      "Model": "gpt-4o"
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/",
      "ApiKey": "YOUR_GEMINI_KEY",
      "Model": "gemini-1.5-flash",
      "InputTokenCostPerMillion": 0.075,
      "OutputTokenCostPerMillion": 0.30
    }
  },
  "AiJobsV4": {
    "Enabled": false,
    "WorkerEnabled": false,
    "BudgetUiEnabled": false,
    "TaskSkillSuggestionEnabled": false,
    "ActionComposerEnabled": false,
    "ActionComposerTaskCreateEnabled": false,
    "AssistantSessionEnabled": false,
    "AssistantContextRegistryEnabled": false,
    "AssistantResearchPlanEnabled": false,
    "AssistantGoalPlannerEnabled": false,
    "AssistantReadOnlyLoopEnabled": false,
    "AssistantProgressiveInteractionEnabled": false,
    "ProjectLaunchBriefEnabled": false,
    "ProjectLaunchPlanningEnabled": false,
    "ProjectLaunchExecutionEnabled": false,
    "ProjectOperationMonitoringEnabled": false,
    "SafeTestOrchestratorEnabled": false,
    "SafeTestTimeoutSeconds": 900,
    "PollIntervalMilliseconds": 1000,
    "LeaseSeconds": 120,
    "HeartbeatSeconds": 30,
    "BatchSize": 4,
    "MaxAttempts": 3,
    "BaseRetrySeconds": 5,
    "AllowProviderDegradedMock": false,
    "EnabledJobTypes": []
  },
  "PrivacyV4": {
    "Enabled": false,
    "WorkerEnabled": false,
    "EnforceSensitiveIngestion": false,
    "PollIntervalMilliseconds": 1000,
    "LeaseSeconds": 120,
    "BatchSize": 4,
    "MaxAttempts": 5,
    "BaseRetrySeconds": 30,
    "MaxPayloadCharacters": 80000,
    "ExportLifetimeMinutes": 60,
    "DsarDeadlineDays": 30,
    "AllowedRetentionDays": [7, 30, 90, 180, 365]
  },
  "AllowedHosts": "*"
}
