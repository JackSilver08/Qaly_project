{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=QalyDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  "Redis": {  
    "ConnectionString": "localhost:6380"
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": "1025",
    "From": "qaly@local.dev",
    "EnableSsl": "false"
  },
  "InvitationLink": {
    "FrontendBaseUrl": "https://app.qaly.example",
    "AcceptInvitationPath": "/invitations/accept"
  },
  "LiveKit": {
    "ServerUrl": "wss://<livekit-host>",
    "ApiKey": "<livekit-api-key>",
    "ApiSecret": "<livekit-api-secret>",
    "TokenTtlMinutes": 120
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Ai": {
    "SemanticEnabled": false,
    "OllamaUrl": "http://localhost:11434",
    "QdrantUrl": "http://localhost:6334",
    "ChatModel": "llama3.2:1b",
    "EmbeddingModel": "nomic-embed-text",
    "VectorSize": 768
  },
  "AiSettings": {
    "Provider": "Ollama",
    "TimeoutSeconds": 30,
    "MaxRetries": 2,
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.2:1b"
    },
    "OpenAI": {
      "ApiKey": "YOUR_OPENAI_KEY",
      "Model": "gpt-4o"
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/",
      "ApiKey": "YOUR_GEMINI_KEY",
      "Model": "gemini-1.5-flash",
      "InputTokenCostPerMillion": 0.075,
      "OutputTokenCostPerMillion": 0.30
    }
  },
  "AllowedHosts": "*"
}
