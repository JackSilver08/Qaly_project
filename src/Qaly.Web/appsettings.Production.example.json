{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<sql-host>,1433;Database=QalyDb;User Id=<user>;Password=<password>;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Redis": {
    "ConnectionString": "<redis-host>:6379"
  },
  "Email": {
    "SmtpHost": "<smtp-host>",
    "SmtpPort": "587",
    "From": "noreply@qaly.example",
    "EnableSsl": "true"
  },
  "InvitationLink": {
    "FrontendBaseUrl": "https://app.qaly.example",
    "AcceptInvitationPath": "/invitations/accept"
  },
  "LiveKit": {
    "ServerUrl": "wss://<livekit-host>",
    "ApiKey": "<set-with-LiveKit__ApiKey>",
    "ApiSecret": "<set-with-LiveKit__ApiSecret>",
    "TokenTtlMinutes": 120
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Ai": {
    "AgentFramework": {
      "Enabled": false,
      "TimeoutSeconds": 45
    },
    "SemanticEnabled": false,
    "OllamaUrl": "http://<ollama-host>:11434",
    "QdrantUrl": "http://<qdrant-host>:6333",
    "ChatModel": "llama3.2:1b",
    "EmbeddingModel": "nomic-embed-text",
    "VectorSize": 768
  },
  "AiSettings": {
    "Provider": "Ollama",
    "FallbackProviders": ["Ollama", "OpenAI", "Gemini"],
    "AllowProviderDegradedMock": false,
    "AllowLocalSensitiveProcessing": false,
    "ProviderTimeoutSeconds": 30,
    "SchemaRepairAttempts": 2,
    "Ollama": {
      "BaseUrl": "http://<ollama-host>:11434",
      "Model": "llama3.2:1b"
    },
    "DeepSeek": {
      "BaseUrl": "https://api.deepseek.com",
      "ApiKey": "<set-with-DEEPSEEK_API_KEY>",
      "Model": "deepseek-v4-pro",
      "InputTokenCostPerMillion": 0.435,
      "OutputTokenCostPerMillion": 0.87
    },
    "OpenAI": {
      "ApiKey": "<set-with-OPENAI_API_KEY>",
      "Model": "gpt-4o"
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/",
      "ApiKey": "<set-with-GEMINI_API_KEY>",
      "Model": "gemini-1.5-flash",
      "InputTokenCostPerMillion": 0.075,
      "OutputTokenCostPerMillion": 0.30
    }
  },
  "AiJobsV4": {
    "Enabled": false,
    "WorkerEnabled": false,
    "BudgetUiEnabled": false,
    "TaskSkillSuggestionEnabled": false,
    "ActionComposerEnabled": false,
    "ActionComposerTaskCreateEnabled": false,
    "AssistantSessionEnabled": false,
    "AssistantContextRegistryEnabled": false,
    "AssistantResearchPlanEnabled": false,
    "AssistantGoalPlannerEnabled": false,
    "PollIntervalMilliseconds": 1000,
    "LeaseSeconds": 120,
    "HeartbeatSeconds": 30,
    "BatchSize": 4,
    "MaxAttempts": 3,
    "BaseRetrySeconds": 5,
    "AllowProviderDegradedMock": false,
    "EnabledJobTypes": []
  },
  "PrivacyV4": {
    "Enabled": false,
    "WorkerEnabled": false,
    "EnforceSensitiveIngestion": false,
    "PollIntervalMilliseconds": 1000,
    "LeaseSeconds": 120,
    "BatchSize": 4,
    "MaxAttempts": 5,
    "BaseRetrySeconds": 30,
    "MaxPayloadCharacters": 80000,
    "ExportLifetimeMinutes": 60,
    "DsarDeadlineDays": 30,
    "AllowedRetentionDays": [7, 30, 90, 180, 365]
  },
  "AllowedHosts": "app.qaly.example"
}
