@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  color-scheme: light;

  /* Breakpoints */
  --breakpoint-sm: 640px;
  --breakpoint-md: 768px;
  --breakpoint-lg: 1024px;
  --breakpoint-xl: 1280px;
  --breakpoint-2xl: 1536px;

  /* Colors */
  --primary: #1f80ff;
  --primary-hover: #0f6fe8;
  --primary-soft: #eaf4ff;
  --surface-milk: #fffdf7;
  --surface-warm: #f7f4ee;
  --blue-50: #eaf4ff;
  --blue-100: #d8ebff;
  --blue-500: #1f80ff;
  --blue-600: #0f6fe8;
  --blue-700: #0759c7;
  --violet-100: #ede9fe;
  --violet-500: #8b5cf6;
  --mint-100: #d1fae5;
  --mint-500: #34d399;
  --peach-100: #fee2d5;
  --peach-500: #fb7185;
  --bg: #f7f4ee;
  --panel: #fffdf7;
  --panel-soft: #f8fafc;
  --text: #142033;
  --muted: #7b8798;
  --line: #dde5ef;
  --glass: rgba(255, 255, 255, 0.68);
  --glass-strong: rgba(255, 255, 255, 0.82);
  --glass-border: rgba(218, 228, 240, 0.76);
  --shadow-soft: 0 18px 45px rgba(31, 128, 255, 0.12);
  --shadow-card: 0 14px 36px rgba(15, 23, 42, 0.08);

  /* Radius */
  --radius-shell: 20px;
  --radius-panel: 16px;
  --radius-card: 12px;
  --radius-pill: 999px;

  /* Spacing - responsive scale */
  --space-1: 6px;
  --space-2: 12px;
  --space-3: 20px;
  --space-4: 28px;

  /* Typography */
  --font-title-lg: 16px;
  --font-title-sm: 15px;
  --font-body: 13px;
  --line-title: 1.35;
  --line-body: 1.5;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  scrollbar-width: none;
  scrollbar-gutter: auto;
  -ms-overflow-style: none;
}

*::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

*::-webkit-scrollbar-track,
*::-webkit-scrollbar-thumb,
*::-webkit-scrollbar-corner {
  border: 0;
  background: transparent;
}
