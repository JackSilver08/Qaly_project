@page
@model Qaly.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<main class="auth-page login-page recovery-page">
    <div class="auth-container">
        <section class="auth-side-form" aria-labelledby="recovery-title">
            <div class="login-form-shell">
                <a class="recovery-back" asp-page="/Account/Login"><span aria-hidden="true">←</span> Quay lại đăng nhập</a>
                <div class="auth-card__brand">
                    <span class="brand-logo">Qaly Workspace</span>
                    <h1 id="recovery-title">Quên mật khẩu?</h1>
                    <p>Lấy lại quyền truy cập để tiếp tục công việc cùng đội ngũ.</p>
                </div>

                <div class="recovery-notice">
                    <strong>Khôi phục qua quản trị viên</strong>
                    <p>Đặt lại mật khẩu tự động qua email chưa được bật. Soạn yêu cầu bên dưới rồi gửi cho quản trị viên tổ chức qua kênh liên hệ bạn đang sử dụng.</p>
                </div>

                @if (Model.RequestPrepared)
                {
                    <div class="recovery-result" role="status">
                        <strong>Yêu cầu đã được soạn — chưa gửi đi</strong>
                        <p>Sao chép nội dung này và gửi cho quản trị viên. Mật khẩu của bạn chưa thay đổi.</p>
                    </div>
                    <div class="auth-form">
                        <label for="recovery-request"><span>Nội dung yêu cầu hỗ trợ</span></label>
                        <textarea id="recovery-request" readonly rows="5">@Model.RecoveryRequest</textarea>
                        <button id="copy-recovery-request" type="button">Sao chép yêu cầu</button>
                        <span id="copy-recovery-status" class="recovery-copy-status" role="status"></span>
                    </div>
                    <div class="auth-link"><a asp-page="/Account/ForgotPassword">Dùng email khác</a></div>
                }
                else
                {
                    <form method="post" class="auth-form">
                        <label asp-for="Email"><span>Email tài khoản</span></label>
                        <input asp-for="Email" type="email" autocomplete="email" placeholder="ten@congty.com" maxlength="254" required aria-describedby="recovery-email-error" />
                        <span asp-validation-for="Email" id="recovery-email-error" class="recovery-validation" role="alert"></span>
                        <button type="submit">Soạn yêu cầu hỗ trợ</button>
                    </form>
                }

                <div class="auth-hint recovery-hint">
                    <strong>Bảo vệ tài khoản</strong>
                    <span>Chỉ cung cấp email tài khoản. Không gửi mật khẩu cũ, mã xác thực hay thông tin bí mật.</span>
                </div>
            </div>
        </section>
        <section class="auth-side-visual" aria-label="Không gian làm việc Qaly">
            <div class="auth-visual-inner">
                <img src="~/images/login-illustration-new.png" alt="Không gian cộng tác của đội ngũ Qaly" />
                <div class="auth-visual-content">
                    <h2>Trở lại cùng đội ngũ</h2>
                    <p>Dự án và công việc vẫn ở đây. Khôi phục quyền truy cập an toàn để tiếp tục từ nơi bạn dừng lại.</p>
                </div>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        document.getElementById('copy-recovery-request')?.addEventListener('click', async function () {
            const request = document.getElementById('recovery-request');
            const status = document.getElementById('copy-recovery-status');
            try {
                await navigator.clipboard.writeText(request.value);
                status.textContent = 'Đã sao chép. Hãy gửi nội dung cho quản trị viên của bạn.';
            } catch {
                request.focus();
                request.select();
                status.textContent = 'Nội dung đã được chọn. Nhấn Ctrl+C (hoặc Cmd+C) để sao chép.';
            }
        });
    </script>
}
