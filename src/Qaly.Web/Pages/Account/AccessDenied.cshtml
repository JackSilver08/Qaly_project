@page
@model Qaly.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<main class="auth-page">
    <section class="auth-card">
        <div class="auth-card__brand">
            <span>Qaly</span>
            <h1>Không có quyền truy cập</h1>
            <p>Tài khoản của bạn không có quyền mở khu vực này trong không gian làm việc.</p>
        </div>
        <p class="auth-link"><a asp-page="/Index">Quay lại bảng điều khiển</a></p>
    </section>
</main>
