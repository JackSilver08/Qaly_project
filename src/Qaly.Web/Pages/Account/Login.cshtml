@page
@model Qaly.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<main class="auth-page login-page">
    <div class="auth-container">
        <section class="auth-side-form">
            <div class="login-form-shell">
                <div class="auth-card__brand">
                    <span class="brand-logo">Qaly Workspace</span>
                    <h1>Welcome back</h1>
                    <p>Elevate your projects with high-precision management.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="auth-error">@Model.ErrorMessage</div>
                }

                <form method="post" class="auth-form" id="loginForm" asp-antiforgery="false">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <label>
                        <span>Email address</span>
                        <input asp-for="Email" type="email" placeholder="name@company.com" autocomplete="email" required />
                    </label>
                    <label>
                        <span>Password</span>
                        <input asp-for="Password" type="password" placeholder="Password" autocomplete="current-password" required />
                    </label>

                    <div class="auth-options">
                        <label class="remember-option">
                            <input type="checkbox" />
                            <span>Remember me</span>
                        </label>
                        <a href="#">Forgot password?</a>
                    </div>

                    <button type="submit">Log In</button>
                </form>

                <div class="auth-link">
                    Don't have an account? <a asp-page="/Account/Register">Sign Up</a>
                </div>

                <div class="auth-hint">
                    <strong>Seed admin</strong>
                    <span>admin@qaly.dev / Admin@123</span>
                </div>
            </div>
        </section>

        <section class="auth-side-visual">
            <div class="auth-particles">
                <div class="auth-particle particle-one"></div>
                <div class="auth-particle particle-two"></div>
                <div class="auth-particle particle-three"></div>
                <div class="auth-particle particle-four"></div>
            </div>

            <div class="floating-pill pill-deadline">
                <div class="icon-dot">OK</div>
                <span>
                    <b>Deadline Met</b>
                    <small>Project A complete</small>
                </span>
            </div>

            <div class="floating-pill pill-efficiency">
                <span>
                    <b>Efficiency</b>
                    <small>+24%</small>
                </span>
                <div class="icon-dot">24</div>
            </div>

            <div class="auth-visual-inner">
                <img src="~/images/login-illustration-new.png" alt="Qaly workspace visualization" />

                <div class="auth-visual-content">
                    <h2>Calculated Precision</h2>
                    <p>Experience a workflow designed for high-stakes enterprise management with high-fidelity visualization.</p>
                </div>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        document.getElementById('loginForm').addEventListener('submit', function() {
            localStorage.setItem('qaly_new_login', 'true');
        });
    </script>
}
