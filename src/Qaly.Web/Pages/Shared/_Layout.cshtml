<!DOCTYPE html>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var isDevelopment = WebHostEnvironment.EnvironmentName == "Development";
    var viteDevServerUrl = Configuration["Vite:DevServerUrl"]?.TrimEnd('/');
    var useViteDevServer = isDevelopment && !string.IsNullOrWhiteSpace(viteDevServerUrl);
}
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Qaly</title>
    <meta name="theme-color" content="#f8fafc" />
    <script>
        (() => {
            const storageKey = 'qaly-theme';
            let storedTheme = null;

            try {
                storedTheme = window.localStorage.getItem(storageKey);
            } catch {
                // Continue with the operating-system preference when storage is unavailable.
            }

            const theme = storedTheme === 'light' || storedTheme === 'dark'
                ? storedTheme
                : window.matchMedia?.('(prefers-color-scheme: dark)').matches
                    ? 'dark'
                    : 'light';

            document.documentElement.dataset.theme = theme;
            document.documentElement.style.colorScheme = theme;

            const themeColor = document.querySelector('meta[name="theme-color"]');
            if (themeColor) {
                themeColor.content = theme === 'dark' ? '#0b1120' : '#f8fafc';
            }
        })();
    </script>
    <link rel="manifest" href="/manifest.json" />
    @if (!useViteDevServer)
    {
        <link rel="stylesheet" href="~/dist/assets/main.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <div id="qaly-toast-root"></div>
    @if (TempData["ToastSuccess"] is string toastSuccess)
    {
        <div hidden data-toast-message="@toastSuccess" data-toast-type="success"></div>
    }
    @if (TempData["ToastError"] is string toastError)
    {
        <div hidden data-toast-message="@toastError" data-toast-type="error"></div>
    }
    @if (useViteDevServer)
    {
        <script type="module" src="@(viteDevServerUrl)/dist/@@vite/client"></script>
        <script type="module" src="@(viteDevServerUrl)/dist/src/Qaly.Web/ClientApp/main.ts"></script>
    }
    else
    {
        <script type="module" src="~/dist/assets/main.js" asp-append-version="true"></script>
    }
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                const isDevelopment = @isDevelopment.ToString().ToLowerInvariant();
                const isAuthPage = window.location.pathname.startsWith('/Account/');

                if (isDevelopment || isAuthPage) {
                    navigator.serviceWorker.getRegistrations()
                        .then(registrations => registrations.forEach(registration => registration.unregister()));

                    if (isDevelopment && 'caches' in window) {
                        caches.keys().then(keys => keys.forEach(key => caches.delete(key)));
                    }

                    return;
                }

                navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' })
                    .then(reg => console.log('SW registered:', reg.scope))
                    .catch(err => console.warn('SW registration failed:', err));
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
